{
  "name": "@slco-peer-support/pwa",
  "private": true,
  "version": "1.2.40",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=peer-support-pwa",
    "pages:dev": "npm run build && wrangler pages dev dist --compatibility-date=2025-04-30",
    "test:peer-support": "node --test scripts/test-peer-support.mjs",
    "docs:howto": "python scripts/generate-howtos.py",
    "docs:admin-howto": "python scripts/generate-howtos.py"
  },
  "dependencies": {
    "ably": "^2.21.0",
    "livekit-client": "^2.21.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.9.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0",
    "wrangler": "^4.17.0"
  }
}
