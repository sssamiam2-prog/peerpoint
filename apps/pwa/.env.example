# Standalone PEERPoint PWA
#
# Realtime auth — local/dev: set an Ably API key (Subscribe + Publish + Presence on peerpoint:room:*).
VITE_ABLY_KEY=
#
# Production (Cloudflare Pages): prefer token auth so the key never ships in the browser.
# Set Pages secret ABLY_API_KEY, then build with:
# VITE_ABLY_AUTH_URL=/api/ably-token
#
# Optional: TURN for Peer voice (many phones/networks need this).
# VITE_WEBRTC_ICE_JSON=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
#
# Optional: `[PeerChat]` logs in production builds.
# VITE_PEER_CHAT_DEBUG=true
#
# Cloudflare Pages Function secrets (dashboard — not Vite):
#   ABLY_API_KEY
#   RESEND_API_KEY          — send Peer Support Member invite emails
#   INVITE_FROM_EMAIL       — verified From address in Resend (e.g. invites@mypeerpoint.com)
#   TEAMS_WEBHOOK_URL       — optional help-request notifications
#   TWILIO_ACCOUNT_SID      — Twilio.org Programmable Messaging (join-link / alert SMS)
#   TWILIO_AUTH_TOKEN
#   TWILIO_FROM_NUMBER      — E.164 From number, e.g. +18015551234
#   LIVEKIT_URL             — LiveKit server URL (server-issued tokens use this)
#   LIVEKIT_API_KEY         — server-only LiveKit API key
#   LIVEKIT_API_SECRET      — server-only LiveKit signing secret; never set a VITE_ variable
#
# Set Twilio secrets (interactive):
#   cd apps/pwa && .\scripts\set-twilio-secrets.ps1
#
# Required binding for accounts + durable requests:
#   PEERPOINT_KV
#
# Seed Admin (created automatically in KV on first login):
#   username: Admin
#   password: (set in ops notes / .env.staff.local — change after first login)
#
# Domains:
#   https://mypeerpoint.com          — members + staff (/staff) + invite setup (/setup)
#   https://admin.mypeerpoint.com    — Admin username login + invites + queue
#
# Local with Functions: npm run pages:dev
# Or tunnel Vite: npx cloudflared tunnel --url http://localhost:5173
