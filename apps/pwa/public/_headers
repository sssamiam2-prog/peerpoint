# Ask crawlers / AI scrapers not to index or archive any response
/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# HTML shell — always revalidate so deploys are not stuck behind CDN/browser cache
/
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
  CDN-Cache-Control: public, max-age=3600

# Hashed Vite assets — long cache, but revalidate so a poisoned SPA HTML
# response for a missing CSS/JS URL cannot stick for a year.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
  CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=60

# Service worker must never be cached stale
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Service-Worker-Allowed: /

/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
  CDN-Cache-Control: no-store

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

# Admin how-to downloads — short cache, revalidate
/docs/*
  Cache-Control: public, max-age=300, must-revalidate
